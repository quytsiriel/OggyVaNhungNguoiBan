/* ==========================================
   GAMEPLAY UI CARTOON UPGRADES
   ========================================== */
#stats-board {
  position: absolute;
  top: 20px;
  left: 20px;
  z-index: 100;
  display: flex;
  flex-direction: column;
  gap: 10px;
  font-family: 'Baloo 2', cursive !important;
}

.stat-item {
  background: #fff;
  border: 4px solid #1e293b;
  border-radius: 15px;
  padding: 10px 20px;
  font-size: 24px;
  font-weight: 900;
  color: #1e293b;
  box-shadow: 6px 6px 0 rgba(0,0,0,0.1);
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 150px;
}

#score-val {
  color: #3b82f6;
  font-size: 28px;
}

#game-timer {
  position: absolute;
  top: 20px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 100;
  background: #ef4444;
  color: #fff;
  border: 4px solid #1e293b;
  border-radius: 20px;
  padding: 10px 30px;
  font-size: 32px;
  font-weight: 900;
  font-family: 'Baloo 2', cursive !important;
  box-shadow: 0 8px 0 #991b1b, 0 10px 20px rgba(0,0,0,0.2);
  text-shadow: 2px 2px 0 rgba(0,0,0,0.3);
}

#help-system {
  position: absolute;
  bottom: 30px;
  left: 30px;
  z-index: 200;
  font-family: 'Baloo 2', cursive !important;
}

#help-btn {
  padding: 12px 25px;
  background: #3b82f6;
  color: white;
  border: 4px solid #1e293b;
  border-radius: 15px;
  font-size: 20px;
  font-weight: 900;
  cursor: pointer;
  box-shadow: 0 6px 0 #1e40af, 0 10px 20px rgba(0,0,0,0.2);
  transition: all 0.1s;
}
#help-btn:active {
  transform: translateY(3px);
  box-shadow: 0 3px 0 #1c5980;
}

#help-menu {
  position: absolute;
  bottom: 80px;
  left: 0;
  background: #fff;
  border: 4px solid #1e293b;
  border-radius: 20px;
  padding: 15px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  min-width: 260px;
  box-shadow: 8px 8px 0 rgba(0,0,0,0.1);
  animation: slideUpHelp 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes slideUpHelp {
  from { transform: translateY(20px) scale(0.8); opacity: 0; }
  to { transform: translateY(0) scale(1); opacity: 1; }
}

.help-opt {
  padding: 12px 15px;
  background: #f8fafc;
  color: #1e293b;
  border: 3px solid #e2e8f0;
  border-radius: 12px;
  cursor: pointer;
  text-align: left;
  font-weight: 800;
  font-size: 16px;
  transition: all 0.2s;
  display: flex;
  align-items: center;
  gap: 10px;
}

.help-opt:hover {
  background: #eff6ff;
  border-color: #3b82f6;
  transform: translateX(5px);
}

#gameplay-hud {
  position: absolute;
  top: 110px;
  width: 100%;
  text-align: center;
  color: white;
  font-size: 26px;
  z-index: 50;
  text-shadow: 2px 2px 0 rgba(0,0,0,0.5);
  pointer-events: none;
  font-weight: 900;
  letter-spacing: 1px;
  font-family: 'Baloo 2', cursive !important;
}

#time-darkness-overlay {
  position: absolute;
  top: 0; left: 0; width: 100%; height: 100%;
  background: black;
  opacity: 0;
  pointer-events: none;
  z-index: 45;
  transition: opacity 0.5s;
}

.flash-warning {
  animation: flashDanger 0.5s infinite alternate;
}

@keyframes flashDanger {
  from { background-color: rgba(0,0,0,0); }
  to { background-color: rgba(255,0,0,0.2); }
}

@keyframes pulseUnmute {
  0% { transform: scale(1); box-shadow: 0 0 20px rgba(34,197,94,0.4); }
  50% { transform: scale(1.1); box-shadow: 0 0 40px rgba(34,197,94,0.7); }
  100% { transform: scale(1); box-shadow: 0 0 20px rgba(34,197,94,0.4); }
}

.hit-text {
  position: absolute;
  font-size: 50px;
  font-weight: 900;
  font-family: 'Baloo 2', cursive;
  color: #f1c40f;
  text-shadow: 4px 4px 0 #1e293b, -2px -2px 0 #fff;
  pointer-events: none;
  z-index: 1000;
  text-transform: uppercase;
  animation: comicPop 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
}

@keyframes comicPop {
  0% { transform: scale(0) rotate(-20deg); opacity: 0; }
  50% { transform: scale(1.5) rotate(10deg); opacity: 1; }
  100% { transform: scale(1.2) rotate(0deg); opacity: 0; transform: translateY(-50px); }
}

/* WIN SCENE STYLES */
#win-card-cartoon {
  background: white;
  border: 8px solid #1e293b;
  border-radius: 40px;
  padding: 40px;
  width: 90%;
  max-width: 600px;
  box-shadow: 15px 15px 0 rgba(0,0,0,0.1);
  text-align: center;
  animation: popIn 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.win-title {
  color: #22c55e;
  font-size: 60px;
  margin: 0;
  text-shadow: 4px 4px 0 rgba(0,0,0,0.05);
}

.win-badge {
  background: #fbbf24;
  color: #1e293b;
  display: inline-block;
  padding: 5px 20px;
  border-radius: 20px;
  font-weight: 900;
  border: 3px solid #1e293b;
  margin-top: -10px;
  transform: rotate(-2deg);
}

.win-msg {
  color: #475569;
  font-size: 20px;
  font-weight: 800;
  margin: 25px 0;
}

.win-stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
  margin-bottom: 30px;
}

.win-stat-item {
  background: #f8fafc;
  border: 3px solid #e2e8f0;
  padding: 15px;
  border-radius: 20px;
}

.stat-label {
  display: block;
  font-size: 14px;
  color: #94a3b8;
  font-weight: 900;
}

.stat-value {
  display: block;
  font-size: 32px;
  color: #1e293b;
  font-weight: 900;
}

.win-actions {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.cartoon-button {
  padding: 15px 30px;
  font-size: 20px;
  font-weight: 900;
  color: white;
  border: 4px solid #1e293b;
  border-radius: 20px;
  cursor: pointer;
  transition: all 0.1s;
  font-family: 'Baloo 2', cursive;
  text-transform: uppercase;
}

.cartoon-button:active {
  transform: translateY(4px);
}
